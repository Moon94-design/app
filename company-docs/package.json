{
  "name": "company-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:src2": "eslint src2 scripts",
    "preview": "vite preview",
    "test:smoke:routes": "node scripts/smoke-routes.mjs",
    "test:smoke": "npm run build && npm run test:smoke:routes",
    "test:p0:consistency": "node --import ./scripts/register-aliases.mjs ./scripts/p0-consistency-regression.ts",
    "check:security": "node scripts/security-check.mjs",
    "check:qa:reuse-build": "npm run test:smoke:routes && npm run check:security && npm run test:p0:consistency",
    "check:qa": "npm run test:smoke && npm run check:security && npm run test:p0:consistency",
    "check:qa:full": "npm run lint:src2 && npm run check:qa"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
